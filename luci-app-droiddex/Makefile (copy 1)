include $(TOPDIR)/rules.mk

PKG_NAME:=luci-app-droiddex
PKG_VERSION:=1.0.0
PKG_RELEASE:=1

PKG_MAINTAINER:=BobbyUnknown <bobbyun.known88@gmail.com>

LUCI_TITLE:=DroidDex - Android Screen Mirroring
LUCI_DEPENDS:=+adb +screen
LUCI_PKGARCH:=all

PKG_LICENSE:=MIT
PKG_LICENSE_FILES:=LICENSE

SCRIPTS_DIR=/etc/droiddex

include $(INCLUDE_DIR)/package.mk

define Package/$(PKG_NAME)
  SECTION:=luci
  CATEGORY:=LuCI
  SUBMENU:=3. Applications
  TITLE:=$(LUCI_TITLE)
  DEPENDS:=$(LUCI_DEPENDS)
  PKGARCH:=$(LUCI_PKGARCH)
endef

define Package/$(PKG_NAME)/description
	 DroidDex is a web-based Android screen mirroring solution that allows you to control and view Android devices through a web browser.
endef

define Build/Prepare
	mkdir -p $(PKG_BUILD_DIR)

	if [ -f "$(CURDIR)/../core/droiddex-aarch64.tar.gz" ]; then \
	  tar -xzf $(CURDIR)/../core/droiddex-aarch64.tar.gz -C $(PKG_BUILD_DIR); \
	elif [ -f "$(CURDIR)/../core/droiddex-x86_64.tar.gz" ]; then \
	  tar -xzf $(CURDIR)/../core/droiddex-x86_64.tar.gz -C $(PKG_BUILD_DIR); \
	fi
endef

define Build/Compile
	# No compilation steps required
endef

define Package/$(PKG_NAME)/install
	$(INSTALL_DIR) $(1)/usr/share/luci/menu.d
	$(INSTALL_DATA) ./usr/share/luci/menu.d/* $(1)/usr/share/luci/menu.d/

	$(INSTALL_DIR) $(1)/usr/share/rpcd/acl.d
	$(INSTALL_DATA) ./usr/share/rpcd/acl.d/* $(1)/usr/share/rpcd/acl.d/

	$(INSTALL_DIR) $(1)/etc/init.d
	$(INSTALL_BIN) ./etc/init.d/droiddex $(1)/etc/init.d/droiddex

	$(INSTALL_DIR) $(1)/etc/config
	$(INSTALL_CONF) ./etc/config/droiddex $(1)/etc/config/droiddex

	$(INSTALL_DIR) $(1)/www/luci-static/resources/view/droiddex
	$(INSTALL_DATA) ./htdocs/luci-static/resources/view/droiddex/* $(1)/www/luci-static/resources/view/droiddex/
    
    $(INSTALL_DIR) $(1)/usr/share/droiddex

	if [ -f "$(CURDIR)/core/droiddex-aarch64.tar.gz" ]; then \
	  tar -xzf $(CURDIR)/core/droiddex-aarch64.tar.gz -C $(1)/usr/share/droiddex; \
	elif [ -f "$(CURDIR)/core/droiddex-x86_64.tar.gz" ]; then \
	  tar -xzf $(CURDIR)/core/droiddex-x86_64.tar.gz -C $(1)/usr/share/droiddex; \
	fi

	if [ -f "$(1)/usr/share/droiddex/droiddex" ]; then \
	  chmod 0755 $(1)/usr/share/droiddex/droiddex; \
	fi
endef

define Package/$(PKG_NAME)/postinst
#!/bin/sh
[ -n "$$IPKG_INSTROOT" ] || {
    /etc/init.d/droiddex enable
    /etc/init.d/droiddex start
    sleep 5
	/etc/init.d/droiddex stop
	/etc/init.d/droiddex disable
}
endef

define Package/$(PKG_NAME)/prerm
#!/bin/sh
[ -n "$$IPKG_INSTROOT" ] || {
	/etc/init.d/droiddex stop
	/etc/init.d/droiddex disable
	echo "droiddex uninstalled"
	echo "Thank for using this app"
}
endef

$(eval $(call BuildPackage,$(PKG_NAME)))
