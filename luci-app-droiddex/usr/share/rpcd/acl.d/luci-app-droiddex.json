{
    "luci-app-droiddex": {
        "description": "Grant access to droiddex configuration and ADB commands",
        "read": {
            "ubus": {
                "service": [ "list" ],
                "file": [ "read" ]
            },
            "uci": [ "droiddex" ],
            "file": {
                "/var/log/droiddex/droiddex.log": [ "read" ],
                "/usr/bin/adb": [ "exec" ],
                "/etc/init.d/droiddex": [ "exec" ],
                "/sbin/uci": [ "exec" ]
            }
        },
        "write": {
            "ubus": {
                "service": [ "event", "start", "stop" ],
                "file": [ "write", "exec" ]
            },
            "uci": [ "droiddex" ],
            "file": {
                "/var/log/droiddex/droiddex.log": [ "write" ],
                "/usr/bin/adb": [ "exec" ],
                "/etc/init.d/droiddex": [ "exec" ],
                "/sbin/uci": [ "exec" ]
            }
        }
    }
}
